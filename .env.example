# Токен бота от @BotFather. Обязательно.
BOT_TOKEN=

# Файл базы данных (каталог создастся автоматически).
DB_PATH=data/schedules.db

# Часовой пояс для «сегодня» и дат.
TZ=Europe/Moscow

# Путь к tesseract, если его нет в PATH (актуально для Windows).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Путь к каталогу tessdata, если Tesseract не находит язык rus автоматически.
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# Предупреждать, если картинка уже этой ширины.
MIN_IMAGE_WIDTH=600

# Максимальный размер принимаемого файла в мегабайтах.
MAX_IMAGE_MB=20
